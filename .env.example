# ── Anthropic Claude API ──────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Supabase（データベース）──────────────────────
# Supabase プロジェクト → Settings → API で確認にゃ
SUPABASE_URL=https://xxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJxxxxxxx...  # service_role キーを使うにゃ（anon keyではないにゃ）

# ── Notion連携（任意）────────────────────────────
NOTION_TOKEN=your_notion_integration_token_here
NOTION_PARENT_PAGE_ID=your_notion_page_id_here

# ── メール取得設定 ────────────────────────────────
GMAIL_QUERY=is:unread is:inbox -from:me
MAX_EMAILS_PER_FETCH=50

# ── Claude モデル ─────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6

# ── Streamlit Cloud / サーバーデプロイ専用（ローカルでは不要）──
# credentials.json の中身をそのまま貼り付けるにゃ
GMAIL_CREDENTIALS_JSON=

# token.json の中身をそのまま貼り付けるにゃ（ローカルで認証後に取得）
GMAIL_TOKEN_JSON=
