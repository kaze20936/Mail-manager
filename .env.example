# ── Anthropic Claude API ──────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Notion連携（任意）────────────────────────────
NOTION_TOKEN=your_notion_integration_token_here
NOTION_PARENT_PAGE_ID=your_notion_page_id_here

# ── メール取得設定 ────────────────────────────────
GMAIL_QUERY=is:unread is:inbox -from:me
MAX_EMAILS_PER_FETCH=50

# ── Claude モデル ─────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6

# ── Railway デプロイ専用（ローカルでは不要）──────
# credentials.json の中身をそのまま貼り付けるにゃ
GMAIL_CREDENTIALS_JSON=

# token.json の中身をそのまま貼り付けるにゃ（ローカルで認証後に取得）
GMAIL_TOKEN_JSON=

# 永続ボリュームのマウントパス（Railway で /data に設定するにゃ）
DATA_DIR=/data
